---
import content from '@data/content';
import iconLinkedin from '@assets/svg/icon-linkedin.svg?raw';
import iconInstagram from '@assets/svg/icon-instagram.svg?raw';
import iconFacebook from '@assets/svg/icon-facebook.svg?raw';

const { description, tagline, org, legal, connect, copyright } = content.footer;
const email = connect.find(l => l.url.startsWith('mailto:'));
const socials = connect.filter(l => !l.url.startsWith('mailto:'));

const socialIcons: Record<string, string> = {
  LinkedIn: iconLinkedin,
  Instagram: iconInstagram,
  Facebook: iconFacebook,
};
---

<footer class="footer">
  <div class="wrap">

    <div class="footer__top">

      <!-- Brand -->
      <div class="footer__brand">
        <img src="/assets/logo-light.svg" alt="DeepKind" class="footer__logo-img" />
        <p class="footer__tagline" data-i18n="footer.tagline">{tagline}</p>
        <p class="footer__desc">{description}</p>
      </div>

      <!-- Org info -->
      <div>
        <p class="footer__col-heading" data-i18n="footer.orgHeading">Organizacja</p>
        <ul class="footer__org-info">
          <li>{org.name}</li>
          <li>{org.city}</li>
          <li>NIP: {org.nip}</li>
          <li>KRS: {org.krs}</li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <p class="footer__col-heading" data-i18n="footer.legalHeading">Dokumenty</p>
        <ul class="footer__links">
          {legal.map((item, i) => (
            <li><a href={item.url} class="footer__link" data-i18n={`footer.legal.${i}.name`}>{item.name}</a></li>
          ))}
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <p class="footer__col-heading" data-i18n="footer.connectHeading">Kontakt</p>
        <ul class="footer__links">
          {email && (
            <li><a href={email.url} class="footer__link">{email.url.replace('mailto:','')}</a></li>
          )}
          <li class="footer__socials-row">
            {socials.map(item => (
              <a
                href={item.url}
                class="footer__social-icon"
                aria-label={item.name}
                target={item.url.startsWith('http') ? '_blank' : undefined}
                rel={item.url.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                <Fragment set:html={socialIcons[item.name] ?? ''} />
              </a>
            ))}
          </li>
        </ul>
      </div>

    </div>

    <div class="footer__rainbow" aria-hidden="true"></div>

    <div class="footer__bottom">
      <p class="footer__copy">{copyright}</p>
    </div>

  </div>
</footer>
