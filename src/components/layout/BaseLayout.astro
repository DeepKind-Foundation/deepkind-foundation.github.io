---
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import SkipLink from '@ui/SkipLink.astro';
import '@styles/global.css';
import '@styles/components.css';
import content from '@data/content';
import PaletteWidget from '@dev/PaletteWidget.astro';
import AccessibilityWidget from '@ui/AccessibilityWidget.astro';
import CookieBanner from '@ui/CookieBanner.astro';
import contentEn from '@data/content.en.json';

interface Props {
  title?: string;
  description?: string;
  schema?: unknown;
  ogImage?: string;
  lang?: 'pl' | 'en';
  alternateUrl?: string;
}

const {
  title = 'DeepKind Foundation: Życzliwość to Energia',
  description = 'Tworzymy inicjatywy, które łączą ludzi, technologię i troskę. DeepKind: Merging Humanity with Technology.',
  schema,
  ogImage,
  lang = 'pl',
  alternateUrl,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://deepkind.org');
const ogLocale = lang === 'en' ? 'en_US' : 'pl_PL';

// BreadcrumbList — auto-derived from the URL path, no per-page wiring required.
const navLinks = lang === 'en' ? contentEn.navigation.links : content.navigation.links;
const blogLabel = navLinks.find(l => l.url === '/blog')?.name ?? 'Blog';
const homeLabel = lang === 'en' ? 'Home' : 'Strona główna';
const homeUrl = new URL(lang === 'en' ? '/en/' : '/', Astro.site ?? 'https://deepkind.org').href;
const pathSegments = Astro.url.pathname.split('/').filter(seg => seg && seg !== 'en');
const pageLabel = title.split(/\s[|—]\s/)[0];
const breadcrumbItems: { '@type': 'ListItem'; position: number; name: string; item: string }[] = [
  { '@type': 'ListItem', position: 1, name: homeLabel, item: homeUrl },
];
if (pathSegments[0] === 'blog' && pathSegments.length > 1) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 2,
    name: blogLabel,
    item: new URL('/blog/', Astro.site ?? 'https://deepkind.org').href,
  });
}
if (pathSegments.length > 0) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: breadcrumbItems.length + 1,
    name: pageLabel,
    item: canonicalURL.href,
  });
}
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
};

function safeJsonLd(obj: unknown): string {
  return JSON.stringify(obj)
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/&/g, '\\u0026')
    .replace(new RegExp('\u2028', 'g'), '\\u2028')
    .replace(new RegExp('\u2029', 'g'), '\\u2029');
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang alternates -->
    <link rel="alternate" hreflang={lang} href={canonicalURL} />
    {alternateUrl && <link rel="alternate" hreflang={lang === 'en' ? 'pl' : 'en'} href={alternateUrl} />}
    <link rel="alternate" hreflang="x-default" href={lang === 'en' ? new URL(Astro.url.pathname.replace('/en/', '/'), Astro.site ?? 'https://deepkind.org').href : canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:locale"      content={ogLocale} />
    <meta property="og:image"         content={ogImage ? new URL(ogImage, canonicalURL).href : new URL('/assets/og-image.png', canonicalURL).href} />
    <meta property="og:image:width"   content="1200" />
    <meta property="og:image:height"  content="628" />
    <meta property="og:image:type"    content="image/png" />

    <!-- Twitter / X -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={new URL('/assets/og-image.png', canonicalURL).href} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={safeJsonLd({
      "@context": "https://schema.org",
      "@type": "NGO",
      "name": "DeepKind Foundation",
      "alternateName": "DeepKind",
      "url": "https://deepkind.org",
      "logo": "https://deepkind.org/assets/logo.png",
      "description": content.footer.description,
      "inLanguage": "pl",
      "areaServed": "PL",
      "taxID": content.footer.org.nip,
      "identifier": {
        "@type": "PropertyValue",
        "propertyID": "KRS",
        "value": content.footer.org.krs
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": content.footer.org.street,
        "addressLocality": "Warszawa",
        "postalCode": content.footer.org.postalCode,
        "addressCountry": "PL"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": content.footer.connect.find(l => l.url.startsWith('mailto:'))?.url.replace('mailto:', '') || '',
        "contactType": "customer support",
        "availableLanguage": ["Polish", "English"]
      },
      "knowsAbout": ["technologia i etyka", "edukacja technologiczna", "różnorodność neurologiczna", "wsparcie kobiet w technologii"],
      ...(content.footer.org.foundingDate && { "foundingDate": content.footer.org.foundingDate }),
      "potentialAction": {
        "@type": "DonateAction",
        "name": "Wesprzyj fundację",
        "target": "https://deepkind.org/wesprzyj"
      },
      "sameAs": content.footer.org.sameAs || content.footer.connect.filter(l => !l.url.startsWith('mailto:') && l.url !== '#').map(l => l.url)
    })} />

    {pathSegments.length > 0 && <script type="application/ld+json" set:html={safeJsonLd(breadcrumbSchema)} />}

    {schema && <script type="application/ld+json" set:html={safeJsonLd(schema)} />}

    <!-- Content Security Policy -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://analytics.google.com https://www.googletagmanager.com https://cloudflareinsights.com; object-src 'none'; base-uri 'self';" />

    <!-- Google Analytics -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4TK4KRLHV4"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4TK4KRLHV4');
    </script>

    <!-- Theme color (matches dark nav / hero) -->
    <meta name="theme-color" content="#0C0E1A" />

    <!-- i18n: English content for client-side language toggle -->
    <script type="application/json" id="i18n-en" set:html={JSON.stringify(contentEn)}></script>

    <!-- Favicon (inline SVG) -->
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/favicon.png" type="image/png" />
  </head>
  <body>
    <SkipLink />
    <Nav />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <AccessibilityWidget />
    <CookieBanner />
  </body>

  <script src="@scripts/reveal.ts"></script>
  <script src="@scripts/i18n.ts"></script>
  {import.meta.env.DEV && <PaletteWidget />}
</html>
