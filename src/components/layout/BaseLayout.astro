---
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import SkipLink from '@ui/SkipLink.astro';
import '@styles/global.css';
import '@styles/components.css';
import content from '@data/content';
import PaletteWidget from '@dev/PaletteWidget.astro';
import AccessibilityWidget from '@ui/AccessibilityWidget.astro';
import CookieBanner from '@ui/CookieBanner.astro';
import contentEn from '@data/content.en.json';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'DeepKind Foundation: Życzliwość to Energia',
  description = 'Tworzymy inicjatywy, które łączą ludzi, technologię i troskę. DeepKind: Merging Humanity with Technology.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://deepkind.org');

function safeJsonLd(obj: unknown): string {
  return JSON.stringify(obj)
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/&/g, '\\u0026')
    .replace(new RegExp('\u2028', 'g'), '\\u2028')
    .replace(new RegExp('\u2029', 'g'), '\\u2029');
}
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:locale"      content="pl_PL" />
    <meta property="og:image"         content={new URL('/assets/og-image.png', canonicalURL).href} />
    <meta property="og:image:width"   content="1200" />
    <meta property="og:image:height"  content="628" />
    <meta property="og:image:type"    content="image/png" />

    <!-- Twitter / X -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={new URL('/assets/og-image.png', canonicalURL).href} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={safeJsonLd({
      "@context": "https://schema.org",
      "@type": "NGO",
      "name": "DeepKind Foundation",
      "alternateName": "DeepKind",
      "url": "https://deepkind.org",
      "logo": "https://deepkind.org/assets/logo.png",
      "description": content.footer.description,
      "email": content.footer.connect.find(l => l.url.startsWith('mailto:'))?.url.replace('mailto:', '') || '',
      "inLanguage": "pl",
      "areaServed": "PL",
      "sameAs": content.footer.connect.filter(l => !l.url.startsWith('mailto:') && l.url !== '#').map(l => l.url)
    })} />

    <!-- Content Security Policy -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com; font-src 'self'; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://www.googletagmanager.com; object-src 'none'; base-uri 'self';" />

    <!-- Google Analytics -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4TK4KRLHV4"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4TK4KRLHV4');
    </script>

    <!-- Theme color (matches dark nav / hero) -->
    <meta name="theme-color" content="#0C0E1A" />

    <!-- i18n: English content for client-side language toggle -->
    <script type="application/json" id="i18n-en" set:html={JSON.stringify(contentEn)}></script>

    <!-- Favicon (inline SVG) -->
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/favicon.png" type="image/png" />
  </head>
  <body>
    <SkipLink />
    <Nav />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <AccessibilityWidget />
    <CookieBanner />
  </body>

  <script src="@scripts/reveal.ts"></script>
  <script src="@scripts/i18n.ts"></script>
  {import.meta.env.DEV && <PaletteWidget />}
</html>
