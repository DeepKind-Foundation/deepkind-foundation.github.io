---
const destination = 'https://deepkind-retreat.lovable.app';
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <link rel="canonical" href={destination} />
    <title>Przekierowanie… / Redirecting…</title>
    <script define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
  </head>
  <body>
    <p>Przekierowujemy… <a href={destination}>Kliknij tutaj, jeśli to nie nastąpi automatycznie.</a></p>
  </body>
</html>
